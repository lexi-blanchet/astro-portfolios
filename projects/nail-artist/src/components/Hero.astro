---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { getIcon } from "../utils/iconMapper";
import { parseInlineLinks } from "../utils/parseInlineLinks";

interface Props {
  hero: {
    name: string;
    title: string;
    image?: ImageMetadata | string;
    description: string;
    avatar: ImageMetadata | string;
    location?: string;
    socialLinks: Array<{
      url: string;
      icon: string;
      label: string;
    }>;
  };
}

const { hero } = Astro.props;

// Determine the background image URL
const defaultImage = "https://img.daisyui.com/images/stock/photo-1507358522600-9f71e620c44e.webp";
const backgroundImage = hero.image 
  ? (typeof hero.image === 'string' ? hero.image : (hero.image as any).src) 
  : defaultImage;
---

<div
  class="hero min-h-screen relative z-[100]"
  style={`background-image: url(${backgroundImage});`}
>
  <div class="hero-content relative z-[9999] text-gray-900 text-center">
    <div class="max-w-md bg-white/30 backdrop-blur-md rounded-[3rem] p-10">
      <figure class="max-w-100 w-48 lg:w-64 mask mask-squircle mb-5">
        {
          typeof hero.avatar === "string" ? (
            <img src={hero.avatar} alt={hero.name} />
          ) : (
            <Image src={hero.avatar} alt={hero.name} />
          )
        }
      </figure>
      <h1 class="mb-5 text-5xl font-bold relative z-[10000]">
        {hero.name}
      </h1>
      <p
        class="mb-5 relative z-[10000]"
        set:html={parseInlineLinks(hero.description)}
      />
      <div
        class="grid grid-cols-4 gap-2 justify-items-center lg:flex lg:gap-4 lg:justify-center"
      >
        {
          hero.socialLinks.map((link) => {
            const IconComponent = getIcon(link.icon as any);
            return (
              <div class="tooltip tooltip-top" data-tip={link.label}>
                <a
                  href={link.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn btn-circle btn-primary lg:btn-ghost"
                  aria-label={link.label}
                >
                  <IconComponent class="size-10" />
                </a>
              </div>
            );
          })
        }
      </div>
    </div>
  </div>
</div>
