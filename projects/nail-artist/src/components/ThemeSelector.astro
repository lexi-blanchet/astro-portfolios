---
---

<div class="fixed top-4 right-4 z-[10001]">
<label class="flex cursor-pointer gap-2">
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="20"
    height="20"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round">
    <circle cx="12" cy="12" r="5" />
    <path
      d="M12 1v2M12 21v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M1 12h2M21 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4" />
  </svg>
  <input type="checkbox" value="dracula" class="toggle theme-controller" />
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="20"
    height="20"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round">
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
  </svg>
</label>

<script is:inline>
  // Set theme on page load based on localStorage or system preference
  function setTheme() {
    const savedTheme = localStorage.getItem("theme");
    let theme = savedTheme;

    // If no saved theme, use system preference
    if (!theme) {
      theme = window.matchMedia("(prefers-color-scheme: dark)").matches
        ? "dracula"
        : "valentine";
    }

    // Apply theme to document
    document.documentElement.setAttribute("data-theme", theme);

    // Set the correct checkbox as checked
    const checkbox = document.querySelector('.toggle.theme-controller');
    if (checkbox) {
      checkbox.checked = (theme === "dracula");
    }
  }

  // Update theme when checkbox is changed
  document.addEventListener("change", (e) => {
    const target = e.target;
    if (target.classList.contains('theme-controller')) {
      const theme = target.checked ? "dracula" : "valentine";
      document.documentElement.setAttribute("data-theme", theme);
      localStorage.setItem("theme", theme);
    }
  });

  // Run on page load
  setTheme();

  // Run after view transitions
  document.addEventListener("astro:after-swap", setTheme);
</script>

</div>
